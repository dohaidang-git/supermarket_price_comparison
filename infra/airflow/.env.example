# Copy to infra/airflow/.env on the pipeline host and replace all placeholders.
# This file is safe to commit. The real .env remains ignored.
PROJECT_ROOT=/absolute/path/to/supermarket
AIRFLOW_UID=50000
DOCKER_GID=999
AIRFLOW_WEBSERVER_PORT=8088
AIRFLOW_WEBSERVER_SECRET_KEY=
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=admin@example.local

# Use immutable GHCR tags in deployment. Leave local values when developing.
AIRFLOW_IMAGE=supermarket-airflow:local
SPARK_IMAGE=supermarket-spark:local

# Optional incoming webhook for final Airflow task failures.
PIPELINE_ALERT_WEBHOOK_URL=
MINIO_ENDPOINT=http://127.0.0.1:9020
MINIO_BUCKET=supermarket-lakehouse
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
